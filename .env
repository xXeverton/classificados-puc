# Storage de imagens. Local é o padrão para desenvolvimento/testes.
STORAGE_PROVIDER=local
# Limite do conteúdo da imagem (5 MiB por padrão).
STORAGE_MAX_IMAGE_BYTES=5242880
# Raiz local e prefixo usado nas URLs locais.
STORAGE_LOCAL_ROOT=media
STORAGE_LOCAL_URL_BASE=/media

# S3 compatível (bucket/região fictícios; não coloque credenciais reais aqui).
# Use uma role/credencial de ambiente sempre que possível.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
# Opcional para MinIO, R2 ou outro endpoint compatível.
STORAGE_S3_ENDPOINT_URL=
# Informe as duas chaves juntas, apenas via ambiente seguro.
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Se vazio, URLs pré-assinadas são geradas por 3600 segundos.
STORAGE_S3_PUBLIC_BASE_URL=
STORAGE_S3_PRESIGN_EXPIRES_SECONDS=3600
# Prefixo opcional dentro do bucket, sem barras nas pontas.
STORAGE_S3_KEY_PREFIX=
